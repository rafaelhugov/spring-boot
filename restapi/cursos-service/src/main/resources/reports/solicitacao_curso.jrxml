<?xml version="1.0" encoding="UTF-8"?>
<!-- Redesigned: 1-page fit, small header, unified list styles for section 3 & 6 -->
<jasperReport name="solicitacao_curso" language="java"
	pageWidth="595" pageHeight="842"
	columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

	<!-- ===================== STYLES ===================== -->
	<style name="PageTitle"  fontName="SansSerif" fontSize="14" bold="true"  forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Middle"/>
	<style name="SubTitle"   fontName="SansSerif" fontSize="9"               forecolor="#FFCDD2" hTextAlign="Left" vTextAlign="Middle"/>
	<style name="SectionHdr" fontName="SansSerif" fontSize="10" bold="true"  forecolor="#FFFFFF" vTextAlign="Middle"/>
	<style name="FieldLabel" fontName="SansSerif" fontSize="9" bold="true"  forecolor="#4e0000"/>
	<style name="FieldValue" fontName="SansSerif" fontSize="9"              forecolor="#1a1a1a"/>
	<style name="CheckOn"    fontName="SansSerif" fontSize="9" bold="true"  forecolor="#B71C1C"/>
	<style name="Footer"     fontName="SansSerif" fontSize="8"  italic="true" forecolor="#9e9e9e" hTextAlign="Right"/>

	<!-- ===================== PARAMETERS ===================== -->
	<parameter name="NOME_EVENTO"              class="java.lang.String"/>
	<parameter name="ESTIMATIVA_PARTICIPANTES" class="java.lang.Integer"/>
	<parameter name="MODALIDADE"               class="java.lang.String"/>
	<parameter name="PUBLICO_ALVO"             class="java.lang.String"/>
	<parameter name="LOCAL_EVENTO"             class="java.lang.String"/>
	<parameter name="CARD_DIVULGACAO"          class="java.lang.String"/>
	<parameter name="COMUNICACAO_IMPRENSA"     class="java.lang.String"/>
	<parameter name="OFICIO_CONVITE"           class="java.lang.String"/>
	<parameter name="COFFEE_BREAK"             class="java.lang.String"/>
	<parameter name="KIT_PARTICIPANTE"         class="java.lang.String"/>
	<parameter name="PROGRAMACAO_IMPRESSA"     class="java.lang.String"/>
	<parameter name="TRASLADO_MINISTRANTE"     class="java.lang.String"/>
	<parameter name="PAGAMENTO_HONORARIO"      class="java.lang.String"/>
	<parameter name="PASSAGEM_AEREA"           class="java.lang.String"/>
	<parameter name="HOSPEDAGEM"               class="java.lang.String"/>
	<parameter name="OBSERVACOES_GERAIS"       class="java.lang.String"/>
	<parameter name="LISTA_AGENDAS"            class="java.lang.String"/>
	<parameter name="LISTA_MINISTRANTES"       class="java.lang.String"/>

	<!-- ================== TITLE BAND ================== -->
	<title height="45" splitType="Stretch">
		<element kind="rectangle" x="0" y="0" width="555" height="40" forecolor="#B71C1C" backcolor="#B71C1C" mode="Opaque">
			<pen lineWidth="0.0"/>
		</element>
		<element kind="rectangle" x="0" y="40" width="555" height="3" forecolor="#7F0000" backcolor="#7F0000" mode="Opaque">
			<pen lineWidth="0.0"/>
		</element>
		<element kind="staticText" x="10" y="5" width="300" height="20" style="PageTitle">
			<text><![CDATA[SOLICITAÇÃO DE CURSO / EVENTO]]></text>
		</element>
		<element kind="staticText" x="10" y="24" width="300" height="12" style="SubTitle">
			<text><![CDATA[Programa de Gestão e Aperfeiçoamento (PGA)  |  MPPB]]></text>
		</element>
		<element kind="textField" x="355" y="10" width="190" height="20" style="PageTitle" hTextAlign="Right" fontSize="10">
			<expression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())]]></expression>
		</element>
	</title>

	<!-- ================== DETAIL BAND ================== -->
	<detail>
		<band height="750" splitType="Stretch">

			<!-- ── 1. IDENTIFICAÇÃO ──────────────────────────── -->
			<element kind="rectangle" x="0" y="0" width="555" height="16" forecolor="#B71C1C" backcolor="#B71C1C" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="6" y="0" width="549" height="16" style="SectionHdr">
				<text><![CDATA[1. IDENTIFICAÇÃO]]></text>
			</element>

			<element kind="staticText"  x="0"   y="22" width="100"  height="12" style="FieldLabel">
				<text><![CDATA[Nome do evento:]]></text>
			</element>
			<element kind="textField"   x="105" y="22" width="450" height="12" style="FieldValue" textAdjust="StretchHeight">
				<expression><![CDATA[$P{NOME_EVENTO}]]></expression>
			</element>
			<element kind="staticText"  x="0"   y="38" width="155" height="12" style="FieldLabel">
				<text><![CDATA[Estimativa de Participantes:]]></text>
			</element>
			<element kind="textField"   x="160" y="38" width="90" height="12" style="FieldValue">
				<expression><![CDATA[$P{ESTIMATIVA_PARTICIPANTES}.toString()]]></expression>
			</element>
			<element kind="staticText"  x="270" y="38" width="75"  height="12" style="FieldLabel">
				<text><![CDATA[Modalidade:]]></text>
			</element>
			<element kind="textField"   x="350" y="38" width="205" height="12" style="FieldValue">
				<expression><![CDATA[$P{MODALIDADE}]]></expression>
			</element>
			<element kind="staticText"  x="0"   y="54" width="100" height="12" style="FieldLabel">
				<text><![CDATA[Público-Alvo:]]></text>
			</element>
			<element kind="textField"   x="105" y="54" width="450" height="12" style="FieldValue">
				<expression><![CDATA[$P{PUBLICO_ALVO}]]></expression>
			</element>
			<element kind="rectangle" x="0" y="70" width="555" height="1" forecolor="#FFCDD2" backcolor="#FFCDD2" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>

			<!-- ── 2. LOCAL DO EVENTO ────────────────────────── -->
			<element kind="rectangle" x="0" y="76" width="555" height="16" forecolor="#B71C1C" backcolor="#B71C1C" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="6" y="76" width="549" height="16" style="SectionHdr">
				<text><![CDATA[2. LOCAL DO EVENTO]]></text>
			</element>
			<element kind="textField"   x="6"  y="96" width="549" height="12" style="FieldValue" textAdjust="StretchHeight">
				<expression><![CDATA[$P{LOCAL_EVENTO}]]></expression>
			</element>
			<element kind="rectangle" x="0" y="112" width="555" height="1" forecolor="#FFCDD2" backcolor="#FFCDD2" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>

			<!-- ── 3. APOIO LOGÍSTICO CEAF ───────────────────── -->
			<element kind="rectangle" x="0" y="118" width="555" height="16" forecolor="#B71C1C" backcolor="#B71C1C" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="6" y="118" width="549" height="16" style="SectionHdr">
				<text><![CDATA[3. APOIO LOGÍSTICO CEAF]]></text>
			</element>

			<!-- Row 1 -->
			<element kind="textField" x="4"   y="138" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{CARD_DIVULGACAO}]]></expression>
			</element>
			<element kind="staticText" x="26" y="138" width="244" height="12" style="FieldValue">
				<text><![CDATA[Card de divulgação]]></text>
			</element>
			<element kind="textField" x="284" y="138" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{COMUNICACAO_IMPRENSA}]]></expression>
			</element>
			<element kind="staticText" x="306" y="138" width="244" height="12" style="FieldValue">
				<text><![CDATA[Comunicação com a imprensa]]></text>
			</element>
			<!-- Row 2 -->
			<element kind="textField" x="4"   y="152" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{OFICIO_CONVITE}]]></expression>
			</element>
			<element kind="staticText" x="26" y="152" width="244" height="12" style="FieldValue">
				<text><![CDATA[Expedição de ofício/convite]]></text>
			</element>
			<element kind="textField" x="284" y="152" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{COFFEE_BREAK}]]></expression>
			</element>
			<element kind="staticText" x="306" y="152" width="244" height="12" style="FieldValue">
				<text><![CDATA[Coffee Break]]></text>
			</element>
			<!-- Row 3 -->
			<element kind="textField" x="4"   y="166" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{KIT_PARTICIPANTE}]]></expression>
			</element>
			<element kind="staticText" x="26" y="166" width="244" height="12" style="FieldValue">
				<text><![CDATA[Kit de eventos (pastas/papel/canetas)]]></text>
			</element>
			<element kind="textField" x="284" y="166" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{TRASLADO_MINISTRANTE}]]></expression>
			</element>
			<element kind="staticText" x="306" y="166" width="244" height="12" style="FieldValue">
				<text><![CDATA[Traslado para ministrante externo]]></text>
			</element>
			<!-- Row 4 -->
			<element kind="textField" x="4"   y="180" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{PROGRAMACAO_IMPRESSA}]]></expression>
			</element>
			<element kind="staticText" x="26" y="180" width="244" height="12" style="FieldValue">
				<text><![CDATA[Programação impressa]]></text>
			</element>

			<element kind="rectangle" x="0" y="196" width="555" height="1" forecolor="#FFCDD2" backcolor="#FFCDD2" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>

			<!-- ── 4. PROGRAMAÇÃO E AGENDAS ──────────────────── -->
			<element kind="rectangle" x="0" y="202" width="555" height="16" forecolor="#B71C1C" backcolor="#B71C1C" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="6" y="202" width="549" height="16" style="SectionHdr">
				<text><![CDATA[4. PROGRAMAÇÃO E AGENDAS]]></text>
			</element>
			<element kind="textField" x="6" y="222" width="549" height="60" style="FieldValue" textAdjust="StretchHeight">
				<expression><![CDATA[$P{LISTA_AGENDAS}]]></expression>
			</element>
			<element kind="rectangle" x="0" y="286" width="555" height="1" forecolor="#FFCDD2" backcolor="#FFCDD2" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>

			<!-- ── 5. MINISTRANTES ───────────────────────────── -->
			<element kind="rectangle" x="0" y="292" width="555" height="16" forecolor="#B71C1C" backcolor="#B71C1C" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="6" y="292" width="549" height="16" style="SectionHdr">
				<text><![CDATA[5. MINISTRANTES (Palestrantes/Mediadores)]]></text>
			</element>
			<element kind="textField" x="6" y="312" width="549" height="80" style="FieldValue" textAdjust="StretchHeight">
				<expression><![CDATA[$P{LISTA_MINISTRANTES}]]></expression>
			</element>
			<element kind="rectangle" x="0" y="396" width="555" height="1" forecolor="#FFCDD2" backcolor="#FFCDD2" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>

			<!-- ── 6. ÔNUS FINANCEIRO ────────────────────────── -->
			<element kind="rectangle" x="0" y="402" width="555" height="16" forecolor="#B71C1C" backcolor="#B71C1C" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="6" y="402" width="549" height="16" style="SectionHdr">
				<text><![CDATA[6. ÔNUS FINANCEIRO]]></text>
			</element>

			<!-- List style matching section 3 -->
			<element kind="textField" x="4"   y="422" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{PAGAMENTO_HONORARIO}]]></expression>
			</element>
			<element kind="staticText" x="26" y="422" width="140" height="12" style="FieldValue">
				<text><![CDATA[Honorários]]></text>
			</element>

			<element kind="textField" x="174" y="422" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{PASSAGEM_AEREA}]]></expression>
			</element>
			<element kind="staticText" x="196" y="422" width="140" height="12" style="FieldValue">
				<text><![CDATA[Passagens aéreas]]></text>
			</element>

			<element kind="textField" x="344" y="422" width="20" height="12" style="CheckOn">
				<expression><![CDATA[$P{HOSPEDAGEM}]]></expression>
			</element>
			<element kind="staticText" x="366" y="422" width="140" height="12" style="FieldValue">
				<text><![CDATA[Hospedagem]]></text>
			</element>

			<element kind="rectangle" x="0" y="438" width="555" height="1" forecolor="#FFCDD2" backcolor="#FFCDD2" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>

			<!-- ── 7. OBSERVAÇÕES / JUSTIFICATIVAS ───────────── -->
			<element kind="rectangle" x="0" y="444" width="555" height="16" forecolor="#B71C1C" backcolor="#B71C1C" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="6" y="444" width="549" height="16" style="SectionHdr">
				<text><![CDATA[7. OBSERVAÇÕES / JUSTIFICATIVAS]]></text>
			</element>
			<element kind="rectangle" x="0" y="464" width="555" height="60" forecolor="#FAFAFA" backcolor="#FAFAFA" mode="Opaque">
				<pen lineColor="#FFCDD2" lineWidth="0.5"/>
			</element>
			<element kind="textField" x="6" y="466" width="543" height="56" style="FieldValue" textAdjust="StretchHeight">
				<expression><![CDATA[$P{OBSERVACOES_GERAIS}]]></expression>
			</element>

			<!-- ── FOOTER ────────────────────────────────────── -->
			<element kind="rectangle" x="0" y="700" width="555" height="1" forecolor="#FFCDD2" backcolor="#FFCDD2" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="textField" x="0" y="704" width="555" height="12" style="Footer">
				<expression><![CDATA["Referência: PGA – MPPB   |   Gerado por Sistema de Solicitação de Cursos"]]></expression>
			</element>
		</band>
	</detail>
</jasperReport>
