	<parameter name="NOME_DIRETOR_CEAF" class="java.lang.String"/>
	
	<field name="nome" class="java.lang.String"/>
	<field name="cargo" class="java.lang.String"/>
	
	<title height="120" splitType="Stretch">
		<element kind="textField" uuid="b905e0c0-913c-4612-8cbb-2e086a3b5660" x="0" y="0" width="555" height="30" hTextAlign="Center" fontName="SansSerif" fontSize="14" bold="true">
			<expression><![CDATA["MINISTÉRIO PÚBLICO DO ESTADO DA PARAÍBA\nPROCURADORIA-GERAL DE JUSTIÇA\nCENTRO DE ESTUDOS E APERFEIÇOAMENTO FUNCIONAL"]]></expression>
		</element>
		<element kind="textField" uuid="4fc9f35f-22a7-47b2-bd74-323e2fb3bc49" x="0" y="40" width="555" height="40" fontName="SansSerif" fontSize="12">
			<expression><![CDATA["À Senhor(a)\n" + $P{NOME_CHEFE_DRH}]]></expression>
		</element>
		<element kind="textField" uuid="a63e9f31-897b-40f4-b258-0eb9473b98c3" x="0" y="80" width="555" height="40" fontName="SansSerif" fontSize="12">
			<expression><![CDATA["Senhor(a) Chefe,\n\nCumprimentando-o(a), comunicamos a Vossa Senhoria, para fins de anotação em ficha funcional, a participação no evento: " + $P{NOME_CURSO} + "."]]></expression>
		</element>
	</title>
	
