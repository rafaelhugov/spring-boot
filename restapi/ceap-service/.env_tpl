# Configurações de execução do NCAP Backend

# Perfil ativo do Spring (dev, prod, insecure, etc.)
SPRING_PROFILES_ACTIVE=dev,insecure

# Porta onde o servidor irá rodar
PORT=8080

# URL de conexão com o banco de dados (ex: local ou atendimento/homologação)
# Adicione ?ssl=true se o banco exigir conexões seguras
PG_URL=jdbc:postgresql://10.128.0.7:5436/ncap?ssl=true
PG_USERNAME=marcelo.borba
PG_PASSWORD=minhasenha123

# Pool de conexões Hikari
POOL_MAX=1
POOL_MIN=1

# Exibição de logs SQL
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=false

# Configurações de CORS
CORS_ENABLED=false
ACCESS_CONTROL_ALLOW_ORIGIN=*
ACCESS_CONTROL_ALLOW_CREDENTIALS=false
