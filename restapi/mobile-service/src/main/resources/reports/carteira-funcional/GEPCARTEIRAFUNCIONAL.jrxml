<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FORMULARIO" pageWidth="300" pageHeight="400" columnWidth="300" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.1961500000000007"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="468"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="imagem" class="java.lang.String" isForPrompting="false"/>
	<parameter name="nofoto" class="java.io.InputStream"/>
	<parameter name="bytesfoto" class="java.lang.Object"/>
	<parameter name="frente" class="java.io.InputStream"/>
	<parameter name="verso" class="java.io.InputStream"/>
	<parameter name="assinatura" class="java.io.InputStream"/>
	<parameter name="PARLOGIN" class="java.lang.String"/>
	<parameter name="qrcode" class="java.lang.String"/>
	<parameter name="PGJ" class="java.lang.String"/>
	<parameter name="color" class="java.lang.String"/>
	<queryString>
		<![CDATA[select s.id as idServidor,
upper(p.nome) as nome,
pf.cpf,
coalesce(pf.rg, '') as rg ,
coalesce(pf.orgaoExp, '') orgaoExp ,
upper(f.nome) as cargo, upper(coalesce(e2.nome, '')) as especialidade, s.matricula, coalesce(s.tituloEleitor , '') as titulo, coalesce(pf.nome_pai, '') as nomePai, coalesce(pf.nome_mae , '') as nomeMae, pf.datanascimento as nascimento,
coalesce(upper(m.nome), '') ||'/'||coalesce(e.sigla, '') as naturalidade ,
tc.tipo as tipocargo, p.id as idPessoa,
case
when f.nome ilike '%procurador%' and pf.sexo = 'M' then 'PROCURADOR DE JUSTIÇA'
when f.nome ilike '%procurador%' and pf.sexo = 'F' then 'PROCURADORA DE JUSTIÇA'
when tc.estagiario = 't' and pf.sexo = 'M' then 'ESTAGIÁRIO'
when tc.estagiario = 't' and pf.sexo = 'F' then 'ESTAGIÁRIA'
when tc.tipo = 'M' and pf.sexo = 'M' then 'PROMOTOR DE JUSTIÇA'
when tc.tipo = 'M' and pf.sexo = 'F' then 'PROMOTORA DE JUSTIÇA'
when tc.tipo = 'S' and pf.sexo = 'M' then 'SERVIDOR'
when tc.tipo = 'S' and pf.sexo = 'F' then 'SERVIDORA'
else '' end as titulocargo
from servidor s
join pessoafisica pf on pf.id_pessoa = s.id_pessoa
join pessoa p on p.id = s.id_pessoa
join recursoshumanos.funcao f on f.id = s.id_cargo
join recursoshumanos.tipocargo tc on f.id_tipocargo = tc.id
left join recursoshumanos.especialidade e2 on e2.id = s.id_especialidade
left join municipio m on m.id = pf.id_municipio
left join estado e on e.id = m.id_estado
where s.ativo = 'A' and s.excluido = false and p.excluido = false
and exists(select id from autorizacao.usuario u where u.matricula= s.matricula and u.login = $P{PARLOGIN} and u.excluido = false limit 1 )
and exists(select id from recursoshumanos.qrcodecarteira u where u.id_servidor= s.id order by u.id desc limit 1 )]]>
	</queryString>
	<field name="idservidor" class="java.lang.Integer"/>
	<field name="nome" class="java.lang.String"/>
	<field name="cpf" class="java.lang.String"/>
	<field name="rg" class="java.lang.String"/>
	<field name="orgaoexp" class="java.lang.String"/>
	<field name="cargo" class="java.lang.String"/>
	<field name="especialidade" class="java.lang.String"/>
	<field name="matricula" class="java.lang.String"/>
