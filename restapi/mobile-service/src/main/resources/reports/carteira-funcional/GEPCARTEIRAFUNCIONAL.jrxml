				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["<span style='color:"+$P{color}+"'>" +($F{tipocargo} .equals( "S") ? $F{cargo}: "")+"</span>"]]></textFieldExpression>
			</textField>
			<staticText>
