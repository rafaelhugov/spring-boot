				<textFieldExpression class="java.lang.String"><![CDATA["<span style='color:" + $P{color} + "'>" +  new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{nascimento}) + "</span>"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField" positionType="Float" x="16" y="163" width="270" height="11"/>
