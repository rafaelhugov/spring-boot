# SPRING_PROFILES_ACTIVE=dev,insecure
SPRING_PROFILES_ACTIVE=dev,insecure
PORT=9003
POOL_MAX=5
POOL_MIN=1

# PG_URL=postgresql://localhost:5402/ATENDIMENTO
PG_URL=postgresql://localhost:5405/DESENVOLVIMENTO
PG_USERNAME=user
PG_PASSWORD=senha

API_URL=https://auth-api.mppb.mp.br

# SQL
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=false

DESIGNACOES_NOTIFICACAO_ENABLED=false
DESIGNACOES_NOTIFICACAO_CRON=0 */15 * * * *
DESIGNACOES_NOTIFICACAO_BATCH_SIZE=100
DESIGNACOES_NOTIFICACAO_MAX_TENTATIVAS=3
DESIGNACOES_FCM_ENABLED=false

# CORS
CORS_ENABLED=false
ACCESS_CONTROL_ALLOW_ORIGIN=*
ACCESS_CONTROL_ALLOW_CREDENTIALS=false
