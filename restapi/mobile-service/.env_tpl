# SPRING_PROFILES_ACTIVE=dev,insecure
SPRING_PROFILES_ACTIVE=dev,insecure
PORT=9003
POOL_MAX=1
POOL_MIN=1

# PG_URL=postgresql://localhost:5402/ATENDIMENTO
PG_URL=postgresql://localhost:5405/DESENVOLVIMENTO
PG_USERNAME=user
PG_PASSWORD=senha

API_URL=https://auth-api.mppb.mp.br

# SQL
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=false

# CORS
CORS_ENABLED=false
ACCESS_CONTROL_ALLOW_ORIGIN=*
ACCESS_CONTROL_ALLOW_CREDENTIALS=false
