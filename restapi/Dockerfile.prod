FROM openjdk:21-jdk-slim

LABEL description="CEAF-Cursos API - Produção Standard"

# Instalação das dependências de fontes (referência utilidades)
RUN apt-get update && apt-get install -y \
    fontconfig \
    libfreetype6 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    fonts-dejavu && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt

# O JAR deve estar na pasta target/ (build externo via Maven)
# O padrão cursos-service-*.jar captura a versão atual do build
ADD cursos-service/target/cursos-service-*.jar /opt/cursos-api.jar

# Configurações de Memória e Java
ENV JAVA_OPTS="-Xms512m -Xmx1g -Dfile.encoding=UTF-8"

# Porta de Produção (Exposto na 8080 interna conforme referência)
EXPOSE 8080 9443

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /opt/cursos-api.jar"]
