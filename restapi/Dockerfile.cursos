# Stage de Runtime (Simples)
FROM eclipse-temurin:21-jdk-alpine

# Instala fontes e fontconfig (necessário para geração de PDF)
RUN apk add --no-cache fontconfig ttf-dejavu

LABEL description="cursos-api"

WORKDIR /opt

# O JAR deve ter sido gerado previamente no host via 'mvn package'
# O contexto do build no docker-compose deve permitir acesso ao target/
COPY cursos-api-latest.jar cursos-api.jar

EXPOSE 9002

ENTRYPOINT ["java", "-jar", "cursos-api.jar"]
